CREATE VIEW
    kimia_farma.view_geoMapTotalProfit AS --Membuat tabel hasil
SELECT 
    kc.provinsi,
    SUM(ft.price * (1 - ft.discount_percentage / 100)) AS total_profit -- Menghitung total pendapatan bersih sebagai total profit
FROM 
    `kimia_farma.kf_final_transaction` AS ft
JOIN 
    `kimia_farma.kf_kantor_cabang` AS kc 
    ON ft.branch_id = kc.branch_id --Menghubungkan tabel kantor cabang dengan transaksi berdasarkan branch id
GROUP BY 
    1 --Grouping based on kolom 1 yaitu provinsi
ORDER BY 
    total_profit DESC --Sorting based on total profit terbesar
